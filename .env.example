# Copy to .env for local development. Real environment variables take precedence.
HTTP_ADDR=:8080
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-replace-with-openssl-rand-hex-32
JWT_TTL=24h
LOG_LEVEL=debug
LOG_FORMAT=text
# Comma-separated; leave empty to disable CORS, "*" allows any origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Per client IP; 0 disables.
RATE_LIMIT_RPS=20
AUTH_RATE_LIMIT_RPM=10
# Behind a proxy, the header it sets to the real client IP, e.g. X-Real-IP,
# CF-Connecting-IP or Fly-Client-IP. Leave empty when clients connect directly.
CLIENT_IP_HEADER=
